<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-katiecad">
    <comment>KatieCAD drawing</comment>
    <comment xml:lang="de">KatieCAD-Zeichnung</comment>
    <comment xml:lang="es">Dibujo de KatieCAD</comment>
    <icon name="katiecad"/>
    <glob pattern="*.cadjson"/>
    <sub-class-of type="application/json"/>
  </mime-type>
  <mime-type type="application/x-katiecad-project">
    <comment>KatieCAD project</comment>
    <comment xml:lang="de">KatieCAD-Projekt</comment>
    <comment xml:lang="es">Proyecto de KatieCAD</comment>
    <icon name="katiecad"/>
    <glob pattern="*.katieprj"/>
    <sub-class-of type="application/json"/>
  </mime-type>
</mime-info>
